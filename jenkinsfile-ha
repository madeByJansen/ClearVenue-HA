// ClearVenue HA packaging stays on main; CHANNEL selects the upstream source and image.
pipeline {
    agent any
    options {
        // Use one publishing Jenkins job. Registry version allocation is not atomic.
        disableConcurrentBuilds()
    }
    parameters {
        choice(
            name: 'CHANNEL',
            choices: ['stable', 'beta', 'dev'],
            description: 'stable → prod, beta → beta, dev → main in ClearSignage.'
        )
        string(
            name: 'CLEARSIGNAGE_REF_OVERRIDE',
            defaultValue: '',
            description: 'Optional full 40-character upstream commit SHA. Publishing requires the selected channel release.yaml pin.'
        )
        booleanParam(name: 'PUSH', defaultValue: true,
            description: 'Publish both architectures, record the selected channel version on main, and prune that channel.')
    }
    environment {
        REGISTRY = 'ghcr.io'
        // Existing credential IDs are retained so the current Jenkins job keeps working.
        GHCR = credentials('ghcr-clearsignage')
    }
    stages {
        stage('Select channel') {
            steps {
                script {
                    env.CHANNEL = params.CHANNEL ?: 'stable'
                    env.ADDON_DIR = sh(script: 'python3 scripts/channels.py --field addon_dir', returnStdout: true).trim()
                    env.PACKAGE = sh(script: 'python3 scripts/channels.py --field package', returnStdout: true).trim()
                    env.SOURCE_BRANCH = sh(script: 'python3 scripts/channels.py --field branch', returnStdout: true).trim()
                    env.IMAGE = sh(script: 'python3 scripts/channels.py --field image', returnStdout: true).trim()
                }
                echo "ClearVenue ${env.CHANNEL}: ClearSignage/${env.SOURCE_BRANCH} → ${env.IMAGE}"
            }
        }
        stage('Validate packaging') {
            steps {
                sh '''#!/usr/bin/env bash
                    set -euo pipefail
                    rm -rf .venv
                    python3 -m venv .venv
                    .venv/bin/python -m pip install --quiet pytest pyyaml
                    .venv/bin/python -m pytest tests -q
                    .venv/bin/python scripts/sync-channel-packaging.py --check
                '''
            }
        }
        stage('Verify tools') {
            steps {
                sh '''#!/usr/bin/env bash
                    set -euo pipefail
                    docker --version
                    docker buildx version
                    docker run --privileged --rm tonistiigi/binfmt --install arm64
                    if docker buildx inspect clearvenue >/dev/null 2>&1; then
                        docker buildx use clearvenue
                        docker buildx inspect --bootstrap
                    else
                        docker buildx create --name clearvenue --driver docker-container --use --bootstrap
                    fi
                '''
            }
        }
        stage('Fetch ClearSignage source') {
            steps {
                withCredentials([usernamePassword(
                    credentialsId: 'GithubPAT-Workplain-com',
                    usernameVariable: 'GITHUB_USERNAME', passwordVariable: 'GITHUB_TOKEN'
                )]) {
                    sh '''#!/usr/bin/env bash
                        set -euo pipefail
                        ASKPASS_SCRIPT="$(mktemp)"
                        trap 'rm -f "${ASKPASS_SCRIPT}"' EXIT
                        cat > "${ASKPASS_SCRIPT}" <<'EOF'
#!/usr/bin/env bash
case "$1" in
    *Username*) printf '%s\\n' "${GITHUB_USERNAME}" ;;
    *Password*) printf '%s\\n' "${GITHUB_TOKEN}" ;;
    *) exit 1 ;;
esac
EOF
                        chmod 700 "${ASKPASS_SCRIPT}"
                        export GIT_ASKPASS="${ASKPASS_SCRIPT}" GIT_TERMINAL_PROMPT=0
                        # No feature-branch packaging can publish or record onto main.
                        if [ "${PUSH:-true}" = true ]; then
                            git fetch --quiet origin main
                            test "$(git rev-parse HEAD)" = "$(git rev-parse FETCH_HEAD)" || {
                                echo 'Publish from the current packaging main; use PUSH=false for feature branches.' >&2
                                exit 1
                            }
                        fi
                        ./scripts/fetch-source.sh
                    '''
                }
                script {
                    env.RESOLVED_REF = sh(script: 'cat "${ADDON_DIR}/src/CLEARSIGNAGE_REF"', returnStdout: true).trim()
                    withEnv([
                        "PUBLISH_PUSH=${params.PUSH}",
                        "PUBLISH_OVERRIDE=${params.CLEARSIGNAGE_REF_OVERRIDE ?: ''}"
                    ]) {
                        sh '''#!/usr/bin/env bash
                            set -euo pipefail
                            .venv/bin/python ./scripts/check-publish-allowed.py \
                                --push "${PUBLISH_PUSH:-true}" \
                                --channel "${CHANNEL}" \
                                --branch "${SOURCE_BRANCH}" \
                                --override "${PUBLISH_OVERRIDE:-}" \
                                --built-revision "${RESOLVED_REF:-}" \
                                --release-file "${ADDON_DIR}/release.yaml"
                        '''
                    }
                    env.APP_VERSION = sh(
                        script: '''#!/usr/bin/env bash
                            set -euo pipefail
                            GHCR_TOKEN="${GHCR_PSW}" .venv/bin/python ./scripts/next-image-version.py \
                                --channel "${CHANNEL}"
                        ''', returnStdout: true
                    ).trim()
                }
            }
        }
        // The signed screen release this venue hands to the screens that joined it
        // built from RESOLVED_REF, versioned APP_VERSION, signed with
        // the release job's own key, and placed in src/ where the image's COPY picks it up.
        // A published image must carry one — a venue that silently carried none would leave
        // every joined screen where it is — so only a dry run may go without the key.
        stage('Build the screen release') {
            steps {
                script {
                    try {
                        withCredentials([
                            usernamePassword(
                                credentialsId: 'GithubPAT-Workplain-com',
                                usernameVariable: 'GITHUB_USERNAME', passwordVariable: 'GITHUB_TOKEN'
                            ),
                            string(credentialsId: 'update-signing-private-key', variable: 'UPDATE_SIGNING_PRIVATE_KEY')
                        ]) {
                            withEnv(["SCREEN_RELEASE_REQUIRED=${params.PUSH}"]) {
                                sh '''#!/usr/bin/env bash
                                    set -euo pipefail
                                    ASKPASS_SCRIPT="$(mktemp)"
                                    trap 'rm -f "${ASKPASS_SCRIPT}"' EXIT
                                    cat > "${ASKPASS_SCRIPT}" <<'EOF'
#!/usr/bin/env bash
case "$1" in
    *Username*) printf '%s\\n' "${GITHUB_USERNAME}" ;;
    *Password*) printf '%s\\n' "${GITHUB_TOKEN}" ;;
    *) exit 1 ;;
esac
EOF
                                    chmod 700 "${ASKPASS_SCRIPT}"
                                    export GIT_ASKPASS="${ASKPASS_SCRIPT}" GIT_TERMINAL_PROMPT=0
                                    .venv/bin/python -m pip install --quiet cryptography pydantic
                                    SCREEN_RELEASE_VERSION="${APP_VERSION}" \
                                        CLEARSIGNAGE_REF="${RESOLVED_REF}" \
                                        PYTHON="${WORKSPACE}/.venv/bin/python" \
                                        ./scripts/build-screen-release.sh
                                '''
                            }
                        }
                    } catch (org.jenkinsci.plugins.credentialsbinding.impl.CredentialNotFoundException missing) {
                        // Only a missing credential is caught; a broken key, a failed fetch or
                        // a release that does not verify fail the build as themselves.
                        if (params.PUSH) {
                            error "No release signing key (${missing.message}): a published ClearVenue must carry a signed screen release."
                        }
                        echo 'WARNING: no release signing key; this dry-run image carries NO screen release.'
                    }
                }
            }
        }
        // The ClearVenue bundle: one archive per release, made by ClearSignage's own builder
        // from RESOLVED_REF and carrying the screen release above. The image is built from its
        // contents, and it is published beside the image for venues that are not run by Home
        // Assistant. Signed with the same key; only a dry run may go without it.
        stage('Build the venue bundle') {
            steps {
                script {
                    def bundle = '''#!/usr/bin/env bash
                        set -euo pipefail
                        BUNDLE_VERSION="${APP_VERSION}" PYTHON="${WORKSPACE}/.venv/bin/python" \
                            ./scripts/build-venue-bundle.sh
                    '''
                    try {
                        withCredentials([
                            string(credentialsId: 'update-signing-private-key', variable: 'UPDATE_SIGNING_PRIVATE_KEY')
                        ]) {
                            withEnv(["BUNDLE_REQUIRED=${params.PUSH}"]) {
                                sh bundle
                            }
                        }
                    } catch (org.jenkinsci.plugins.credentialsbinding.impl.CredentialNotFoundException missing) {
                        if (params.PUSH) {
                            error "No release signing key (${missing.message}): a published ClearVenue bundle must be signed."
                        }
                        sh bundle
                    }
                }
            }
        }
        stage('Build and publish') {
            steps {
                sh '''#!/usr/bin/env bash
                    set -euo pipefail
                    build_from() {
                        .venv/bin/python -c 'import sys,yaml; print(yaml.safe_load(open(sys.argv[1]))["build_from"][sys.argv[2]])' \
                            "${ADDON_DIR}/build.yaml" "$1"
                    }
                    if [ "${PUSH:-true}" = true ]; then
                        printf '%s' "${GHCR_PSW}" | docker login "${REGISTRY}" --username "${GHCR_USR}" --password-stdin
                        output_mode=(--push)
                    else
                        output_mode=(--output=type=cacheonly)
                    fi
                    build_one() {
                        docker buildx build --builder clearvenue \
                            --platform "$1" --build-arg "BUILD_FROM=$2" \
                            --build-arg "CLEARSIGNAGE_REF=${RESOLVED_REF}" \
                            --label "org.opencontainers.image.revision=${RESOLVED_REF}" \
                            --label "org.opencontainers.image.version=${APP_VERSION}" \
                            --tag "${IMAGE}:${APP_VERSION}-$3" \
                            "${output_mode[@]}" "${ADDON_DIR}"
                    }
                    build_one linux/arm64 "$(build_from aarch64)" aarch64
                    build_one linux/amd64 "$(build_from amd64)" amd64
                    if [ "${PUSH:-true}" = true ]; then
                        docker buildx imagetools create \
                            --tag "${IMAGE}:${APP_VERSION}" --tag "${IMAGE}:latest" \
                            "${IMAGE}:${APP_VERSION}-aarch64" "${IMAGE}:${APP_VERSION}-amd64"
                        docker buildx imagetools inspect "${IMAGE}:${APP_VERSION}"
                    fi
                '''
            }
        }
        // Before the version is recorded: until then nothing offers it, so a bundle that could
        // not be published leaves a release no venue has been told about, on either platform.
        stage('Publish the venue bundle') {
            when { expression { params.PUSH } }
            steps {
                sh '''#!/usr/bin/env bash
                    set -euo pipefail
                    GHCR_USERNAME="${GHCR_USR}" GHCR_TOKEN="${GHCR_PSW}" \
                        .venv/bin/python ./scripts/push-venue-bundle.py \
                        --channel "${CHANNEL}" --version "${APP_VERSION}"
                '''
            }
        }
        stage('Record the published version') {
            when { expression { params.PUSH } }
            steps {
                withCredentials([usernamePassword(
                    credentialsId: 'GithubPAT-Workplain-com',
                    usernameVariable: 'GIT_USERNAME', passwordVariable: 'GIT_PASSWORD'
                )]) {
                    sh '''#!/usr/bin/env bash
                        set -euo pipefail
                        ASKPASS_SCRIPT="$(mktemp)"
                        trap 'rm -f "${ASKPASS_SCRIPT}"' EXIT
                        cat > "${ASKPASS_SCRIPT}" <<'EOF'
#!/usr/bin/env bash
case "$1" in
    *Username*) printf '%s\\n' "${GIT_USERNAME}" ;;
    *Password*) printf '%s\\n' "${GIT_PASSWORD}" ;;
    *) exit 1 ;;
esac
EOF
                        chmod 700 "${ASKPASS_SCRIPT}"
                        export GIT_ASKPASS="${ASKPASS_SCRIPT}" GIT_TERMINAL_PROMPT=0
                        RECORD_VERSION="${APP_VERSION}" RECORD_BRANCH=main \
                            RECORD_PYTHON="${WORKSPACE}/.venv/bin/python" \
                            ./scripts/record-published-version.sh
                    '''
                }
            }
        }
        // Old images and bundles, and the tags of the releases they were: a tag naming a
        // release nobody can install any more is deleted with it.
        stage('Prune old releases') {
            when { expression { params.PUSH } }
            steps {
                withCredentials([usernamePassword(
                    credentialsId: 'GithubPAT-Workplain-com',
                    usernameVariable: 'GIT_USERNAME', passwordVariable: 'GIT_PASSWORD'
                )]) {
                    sh '''#!/usr/bin/env bash
                        set -euo pipefail
                        ASKPASS_SCRIPT="$(mktemp)"
                        trap 'rm -f "${ASKPASS_SCRIPT}"' EXIT
                        cat > "${ASKPASS_SCRIPT}" <<'EOF'
#!/usr/bin/env bash
case "$1" in
    *Username*) printf '%s\\n' "${GIT_USERNAME}" ;;
    *Password*) printf '%s\\n' "${GIT_PASSWORD}" ;;
    *) exit 1 ;;
esac
EOF
                        chmod 700 "${ASKPASS_SCRIPT}"
                        export GIT_ASKPASS="${ASKPASS_SCRIPT}" GIT_TERMINAL_PROMPT=0
                        GHCR_TOKEN="${GHCR_PSW}" .venv/bin/python ./scripts/prune-ghcr-releases.py \
                            --channel "${CHANNEL}" --current "${APP_VERSION}" --apply
                    '''
                }
            }
        }
    }
    post {
        always {
            sh '''#!/usr/bin/env bash
                set +e
                docker logout "${REGISTRY}"
                rm -rf clearvenue/src clearvenue_beta/src clearvenue_dev/src .upstream venue-release .venv
            '''
        }
        success { echo "Completed ClearVenue ${env.CHANNEL} ${env.APP_VERSION}; PUSH=${params.PUSH}; upstream ${env.RESOLVED_REF}" }
        failure { echo 'ClearVenue Home Assistant image build failed.' }
    }
}
